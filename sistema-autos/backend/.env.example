# Railway inyecta DATABASE_URL automaticamente al conectar el plugin de PostgreSQL.
# Para desarrollo local, copia este archivo como .env y completa tus datos.
DATABASE_URL=postgresql://usuario:password@localhost:5432/sistema_autos

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria en produccion)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_segura
JWT_EXPIRES_IN=8h

# Puerto del servidor (Railway asigna PORT automaticamente)
PORT=4000

# Origen permitido para CORS (URL de tu frontend en Vercel)
FRONTEND_URL=http://localhost:5173
